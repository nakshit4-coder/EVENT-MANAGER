# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
VITE_APP_URL="http://localhost:3000"

# Supabase Configuration
# Obtain from Supabase Project Settings -> API (Project URL & Anon public key)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server-Side Only Keys (Never expose with VITE_ prefix!)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Payment Gateway Configuration
# Obtain from Razorpay Dashboard -> Settings -> API Keys (Test or Live mode)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"

